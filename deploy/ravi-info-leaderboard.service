[Unit]
Description=RAVI INFO MISIJA leaderboard API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/inforavi
Environment=LEADERBOARD_DB=/opt/inforavi/data/leaderboard.db
ExecStart=/opt/inforavi/.venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
